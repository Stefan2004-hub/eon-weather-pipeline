# Open-Meteo forecast endpoint and the existing Iași default location.
WEATHER_PIPELINE_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_PIPELINE_LATITUDE=47.1585
WEATHER_PIPELINE_LONGITUDE=27.6014
WEATHER_PIPELINE_TIMEZONE=GMT

# Paths may be absolute or relative to the repository root.
WEATHER_PIPELINE_BRONZE_DIR=data/bronze
WEATHER_PIPELINE_SILVER_DIR=data/silver
WEATHER_PIPELINE_GOLD_DIR=data/gold
WEATHER_PIPELINE_REPORT_PATH=data/analyst_report.md
WEATHER_PIPELINE_LOG_LEVEL=INFO
